{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "city",
    "query",
    "assumptions",
    "coverage",
    "gaps",
    "listings"
  ],
  "properties": {
    "city": {
      "type": "string",
      "minLength": 1
    },
    "query": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "municipality",
        "location_scope",
        "country",
        "property_types",
        "price_min",
        "price_max",
        "house_size_min_m2",
        "house_size_max_m2",
        "land_size_min_m2",
        "land_size_max_m2",
        "must_have",
        "exclude"
      ],
      "properties": {
        "municipality": {
          "type": "string",
          "minLength": 1
        },
        "location_scope": {
          "type": "string"
        },
        "country": {
          "type": "string"
        },
        "property_types": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "price_min": {
          "type": [
            "string",
            "number",
            "null"
          ]
        },
        "price_max": {
          "type": [
            "string",
            "number",
            "null"
          ]
        },
        "house_size_min_m2": {
          "type": [
            "string",
            "number",
            "null"
          ]
        },
        "house_size_max_m2": {
          "type": [
            "string",
            "number",
            "null"
          ]
        },
        "land_size_min_m2": {
          "type": [
            "string",
            "number"
          ]
        },
        "land_size_max_m2": {
          "type": [
            "string",
            "number",
            "null"
          ]
        },
        "must_have": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "exclude": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workers_launched",
        "workers_with_results",
        "candidates_gathered",
        "rows_retained",
        "zero_result_portals",
        "blocked_portals"
      ],
      "properties": {
        "workers_launched": {
          "type": "integer",
          "minimum": 0
        },
        "workers_with_results": {
          "type": "integer",
          "minimum": 0
        },
        "candidates_gathered": {
          "type": "integer",
          "minimum": 0
        },
        "rows_retained": {
          "type": "integer",
          "minimum": 0
        },
        "zero_result_portals": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "blocked_portals": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "portal_status": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "no_results",
              "rate_limited",
              "fetch_error",
              "dns_error",
              "timeout",
              "blocked",
              "inactive",
              "fallback_page",
              "partial",
              "unknown"
            ]
          },
          "http_status": {
            "type": [
              "integer",
              "null"
            ]
          },
          "stage": {
            "type": [
              "string",
              "null"
            ]
          },
          "retained_from_snapshot": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "message": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "fetch_attempts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "portal",
          "url",
          "stage",
          "attempt",
          "status"
        ],
        "properties": {
          "portal": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "stage": {
            "type": "string"
          },
          "attempt": {
            "type": "integer",
            "minimum": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "no_results",
              "rate_limited",
              "fetch_error",
              "dns_error",
              "timeout",
              "blocked",
              "inactive",
              "fallback_page",
              "partial",
              "unknown"
            ]
          },
          "http_status": {
            "type": [
              "integer",
              "null"
            ]
          },
          "error": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "listings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "portal",
          "title",
          "location",
          "property_type",
          "price",
          "house_area_m2",
          "land_area_m2",
          "urls",
          "notes"
        ],
        "properties": {
          "portal": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "title": {
            "type": "string"
          },
          "location": {
            "type": "string"
          },
          "property_type": {
            "type": "string"
          },
          "price": {
            "type": "string"
          },
          "house_area_m2": {
            "type": "string"
          },
          "land_area_m2": {
            "type": "string"
          },
          "urls": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
